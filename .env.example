# --- LLM (any OpenAI-compatible chat/completions API with tool calling) ---
RECONAI_LLM_BASE_URL=https://api.openai.com/v1
RECONAI_LLM_API_KEY=sk-change-me
RECONAI_LLM_MODEL=gpt-4o-mini

# --- API ---
# Required unless RECONAI_INSECURE_NO_AUTH=true. Generate: openssl rand -hex 32
RECONAI_API_KEY=change-me

# --- Tools the agent may use (comma separated). Built-in: nuclei,gobuster,wpscan,nmap ---
RECONAI_TOOLS=nuclei,gobuster,wpscan,nmap

# --- Guard rails ---
# Optional: only accept scans whose targets fall inside these domains/CIDRs
# RECONAI_SCOPE_ALLOWLIST=example.com,203.0.113.0/24
RECONAI_MAX_CONCURRENT_SCANS=3
RECONAI_MAX_STEPS=15
RECONAI_TOOL_TIMEOUT=600
RECONAI_NUCLEI_RATE_LIMIT=50

# Optional: WPScan vulnerability DB token
# WPSCAN_API_TOKEN=
